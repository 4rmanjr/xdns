#compdef xdns
# xdns zsh completion
# Install: sudo cp completions/_xdns /usr/share/zsh/site-functions/_xdns
# Or: cp completions/_xdns ~/.zsh/completions/_xdns (add to fpath)

_xdns() {
    local -a commands
    local -a providers

    providers=(
        '1:Google DNS (Standard)'
        '2:Cloudflare (Fast & Private)'
        '3:Cloudflare (Malware Block)'
        '4:Quad9 (Security & Privacy)'
        '5:AdGuard (Ad Blocking)'
        '6:OpenDNS (Home)'
        '7:Verisign (Stability)'
        '8:Cloudflare (Family Safe)'
        '9:NextDNS (Customizable)'
        '10:Control D (Modern)'
        '11:CleanBrowsing (Family)'
        '12:DNS.SB (Privacy)'
    )

    _arguments -s \
        '(-h --help)'{-h,--help}'[Show help message]' \
        '(-v --version)'{-v,--version}'[Show version]' \
        '(-l --list)'{-l,--list}'[List DNS providers]' \
        '(-s --set)'{-s,--set}'[Set DNS provider]:provider:->provider' \
        '(-c --custom)'{-c,--custom}'[Set custom DNS]' \
        '(-r --restore)'{-r,--restore}'[Restore original DNS]' \
        '(-t --test)'{-t,--test}'[Run speed test]' \
        '--lock[Lock DNS file (immutable)]'

    case "$state" in
        provider)
            _describe -t providers 'DNS provider' providers
            ;;
    esac
}

_xdns "$@"
