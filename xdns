check_root() {
    if [[ $EUID -ne 0 ]]; then
        log_error "Root access required."
        echo "    Run: sudo xdns"
        exit $EXIT_NOT_ROOT
    fi
}

install_missing_deps() {
    local missing_cmds=("$@")
    local pkg_manager=""
    local install_cmd=""
    local -a packages=()

    # Detect Package Manager (ordered by popularity)
    if command -v pacman &> /dev/null; then
        pkg_manager="pacman"
        install_cmd="pacman -Sy --noconfirm"
    elif command -v apt-get &> /dev/null; then
        pkg_manager="apt"
        install_cmd="apt-get update && apt-get install -y"
    elif command -v dnf &> /dev/null; then
        pkg_manager="dnf"
        install_cmd="dnf install -y"
    elif command -v yum &> /dev/null; then
        pkg_manager="yum"
        install_cmd="yum install -y"
    elif command -v zypper &> /dev/null; then
        pkg_manager="zypper"
        install_cmd="zypper install -y"
    elif command -v apk &> /dev/null; then
        pkg_manager="apk"
        install_cmd="apk add --update"
    elif command -v emerge &> /dev/null; then
        pkg_manager="portage"
        install_cmd="emerge --ask=n"
    elif command -v xbps-install &> /dev/null; then
        pkg_manager="xbps"
        install_cmd="xbps-install -y"
    elif command -v eopkg &> /dev/null; then
        pkg_manager="eopkg"
        install_cmd="eopkg install -y"
    else
        log_error "Unknown package manager. Please install manually."
        return 1
    fi

    # Map commands to packages
    for cmd in "${missing_cmds[@]}"; do
        case "$cmd" in
            bc) 
                if [[ "$pkg_manager" == "portage" ]]; then
                    packages+=("sys-devel/bc")
                else
                    packages+=("bc")
                fi
                ;;
            ping)
                case "$pkg_manager" in
                    apt) packages+=("iputils-ping") ;;
                    portage) packages+=("net-misc/iputils") ;;
                    *) packages+=("iputils") ;;
                esac
                ;;
            chattr|lsattr) 
                if [[ "$pkg_manager" == "portage" ]]; then
                    packages+=("sys-fs/e2fsprogs")
                else
                    packages+=("e2fsprogs")
                fi
                ;;
            readlink|mktemp) 
                if [[ "$pkg_manager" == "portage" ]]; then
                    packages+=("sys-apps/coreutils")
                else
                    packages+=("coreutils")
                fi
                ;;
            shellcheck)
                if [[ "$pkg_manager" == "portage" ]]; then
                    packages+=("dev-util/shellcheck")
                else
                    packages+=("shellcheck")
                fi
                ;;
            *) log_warn "Unknown package for command: $cmd";;
        esac
    done

    if [[ ${#packages[@]} -eq 0 ]]; then
         return 1
    fi

    # Remove duplicates (using readarray for ShellCheck compliance)
    local -a unique_packages
    readarray -t unique_packages < <(printf "%s\n" "${packages[@]}" | sort -u)

    echo ""
    log_warn "Missing dependencies found: ${missing_cmds[*]}"
    echo -e "    ${CYAN}Attempting auto-install with $pkg_manager: ${unique_packages[*]}${NC}"
    read -rp "    Continue installation? (y/n): " confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        log_error "Installation cancelled by user."
        return 1
    fi

    log_step "Installing packages..."
    if $install_cmd "${unique_packages[@]}"; then
        log_ok "Installation successful."
        return 0
    else
        log_error "Installation failed."
        return 1
    fi
}

check_dependencies() {
    local required=("bc" "ping" "chattr" "lsattr" "readlink" "mktemp")
    local missing=()
    
    for cmd in "${required[@]}"; do
        if ! command -v "$cmd" &> /dev/null; then
            missing+=("$cmd")
        fi
    done

    if [[ ${#missing[@]} -ne 0 ]]; then
        if ! install_missing_deps "${missing[@]}"; then
            log_error "Missing Dependencies: ${missing[*]}"
            log_info "Please install these packages via your package manager."
            exit $EXIT_MISSING_DEPS
        fi
        
        # Re-check after install attempt
        local still_missing=()
        for cmd in "${required[@]}"; do
            if ! command -v "$cmd" &> /dev/null; then
                still_missing+=("$cmd")
            fi
        done
        
        if [[ ${#still_missing[@]} -ne 0 ]]; then
            log_error "Dependencies still missing after installation attempt: ${still_missing[*]}"
            exit $EXIT_MISSING_DEPS
        fi
        
        echo "" 
        log_ok "All dependencies satisfied. Continuing..."
        sleep 1
    fi
}

# Validate IPv4 address - returns 0 if valid, 1 if invalid
validate_ipv4() {
    local ip="$1"
    local IFS='.'
    local -a octets
    
    # Must match basic IPv4 pattern first
    if [[ ! "$ip" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        return 1
    fi
    
    read -ra octets <<< "$ip"
    
    # Must have exactly 4 octets
    [[ ${#octets[@]} -ne 4 ]] && return 1
    
    # Each octet must be 0-255
    for octet in "${octets[@]}"; do
        # Remove leading zeros for comparison (10# forces base-10)
        octet=$((10#$octet))
        if (( octet < 0 || octet > 255 )); then
            return 1
        fi
    done
    
    return 0
}

